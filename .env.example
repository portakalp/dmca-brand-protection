# Local development settings: cp .env.example .env
# The values below are for the local Docker Compose stack only. Never put real secrets in this
# file; production values live in Secret Manager (architecture.md §26).

ENV=local
LOG_LEVEL=INFO
# Set by the image build; leave empty locally.
GIT_SHA=

# --- Host ports of the compose stack (127.0.0.1) ----------------------------------------------
# Defaults below; uncomment to move one that is taken on your machine (`make demo` prints the
# ports in use). Moving POSTGRES_PORT, REDIS_PORT, FAKE_GCS_PORT or MAILPIT_SMTP_PORT also means
# changing the matching host URLs further down (tests and CLI on the host use them).
# API_PORT=8000
# WEB_PORT=3000
# OPS_PORT=8081
# MAILPIT_PORT=8025
# MAILPIT_SMTP_PORT=2525
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# FAKE_GCS_PORT=4443
# FIXTURE_SITES_PORT=18080
# DEV_PROXY_PORT=18888
# PROMETHEUS_PORT=9090
# ALERTMANAGER_PORT=9093

# --- Compose networks ------------------------------------------------------------------------
# Move these when `make demo` fails with "Pool overlaps with other one on this address space",
# or to run a second copy of the stack (docs/self-hosting.md). FIXTURE_SITES_IP must lie inside
# KALKAN_SUBNET.
# KALKAN_SUBNET=172.30.0.0/16
# FIXTURE_SITES_IP=172.30.255.80
# BROWSER_SUBNET=172.29.250.0/24

# --- Local Postgres (docker compose only) ---------------------------------------------------
# Used by infra/compose/postgres/initdb to create the roles on first start. If you change a
# password, change it in the matching DATABASE_URL_* below and run `make down` +
# `docker volume rm kalkan_postgres-data` to recreate the database.
# In prod Terraform generates the role passwords and DATABASE_URL_* into Secret Manager
# (db-owner-password, db-api-password, db-worker-password; K78).
POSTGRES_PASSWORD=postgres-local-only
DB_OWNER_PASSWORD=kalkan-owner-local-only
DB_API_PASSWORD=kalkan-api-local-only
DB_WORKER_PASSWORD=kalkan-worker-local-only

# --- Connections from the host (tests, CLI) -------------------------------------------------
# Containers get their own service-name URLs from infra/compose/docker-compose.yml.
DATABASE_URL_API=postgresql+psycopg://kalkan_api:kalkan-api-local-only@localhost:5432/kalkan
DATABASE_URL_WORKER=postgresql+psycopg://kalkan_worker:kalkan-worker-local-only@localhost:5432/kalkan
DATABASE_URL_MIGRATE=postgresql+psycopg://kalkan_owner:kalkan-owner-local-only@localhost:5432/kalkan
# Local Redis has no password. On the prod VM REDIS_URL is a Secret Manager secret with a Redis
# user's password (redis-url, redis-browser-url; architecture.md §26; K82).
REDIS_URL=redis://localhost:6379/0
# Object storage: gcs (fake-gcs locally through STORAGE_EMULATOR_HOST) or filesystem (objects
# under STORAGE_ROOT, an absolute path; used by self-hosting). Keys stay gs://<bucket>/<path>.
STORAGE_BACKEND=gcs
# STORAGE_ROOT=/data/objects
STORAGE_EMULATOR_HOST=http://localhost:4443
GCS_EVIDENCE_BUCKET=kalkan-evidence
GCS_REPORTS_BUCKET=kalkan-reports
SMTP_URL=smtp://localhost:2525

# --- Application ------------------------------------------------------------------------------
# The panel's address: links in e-mails, the only address the report print may open
# (worker-browser), and where the print page reads the report data in prod (§21, K169, K170).
APP_BASE_URL=http://localhost:3000
# Optional: the address worker-browser prints reports from when the public one is not
# reachable from its network (self-hosted: http://web:3000). Empty: APP_BASE_URL.
REPORT_PRINT_BASE_URL=
EVIDENCE_BASE_URL=http://localhost:8000
# Empty locally: the API then skips the X-Edge-Auth check. Required in prod.
EDGE_SHARED_SECRET=
# The panel (web/) only, read by `next dev` and `next build`, not from this file: the API that
# /api/* is rewritten to. `make web-dev` and `make web-e2e` take it as a Make variable.
# API_ORIGIN=http://localhost:8000
# Local development only (Fernet key for TOTP secrets); prod gets its key from Secret Manager.
TOTP_ENCRYPTION_KEY=UOyLiUdrqoKJzdlmuhAs7hrIE3MAlRYoTCXTCojQeg8= # gitleaks:allow (local only)
CASE_PREFIX=KLK

# --- AI (architecture.md §13) -----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional AI. Empty: on when ANTHROPIC_API_KEY is set. Off: cases that would go to the AI go
# to the review queue (reason ai_disabled), notices use the fixed paragraph and replies are left
# to the operator; nothing is queued for worker-ai. Set true only when worker-ai runs (up-ai).
AI_ENABLED=
AI_TRIAGE_MODEL=claude-haiku-5-5
AI_CONFIRM_MODEL=claude-sonnet-5-5
AI_TEXT_MODEL=claude-sonnet-5-5
AI_REPLY_MODEL=claude-haiku-5-5
AI_MONTHLY_BUDGET_USD=50
# The alarm line of a day's AI spend (USD); the scheduler exports it to Prometheus (§23).
ALERT_AI_DAILY_USD=5
# Prices per million tokens as JSON (architecture.md §13); empty: the §13 table.
AI_PRICES=

# --- Browser proxy (architecture.md §10) ------------------------------------------------------
# One line of JSON: country code -> proxy URL template http://user:pass@host:port (credentials
# percent-encoded; an optional {session} in them becomes a new token per job). Locally the
# dev-proxy container (tinyproxy; reaches only the *.test fixture sites); tests on the host build
# their own map with http://127.0.0.1:18888. Empty: capture jobs wait (fail closed, §7).
PROXY_MAP='{"PL":"http://dev-proxy:8888"}'
PROXY_DEFAULT_COUNTRY=PL
PROXY_DAILY_GB_LIMIT=2

# --- E-mail and notices (architecture.md §15) -------------------------------------------------
# smtp (default, any ENV): SMTP_URL above. Schemes: smtp://host:port (plain, e.g. Mailpit),
# smtp+starttls://user:pass@host:587, smtps://user:pass@host:465; user and password
# percent-encoded, credentials refused over plain smtp://. postmark: POSTMARK_SERVER_TOKEN.
EMAIL_PROVIDER=smtp
# ENV=prod accepts plain smtp:// only for a relay on loopback, a private address or a compose
# service name; true allows it for any host (mail then crosses the network in clear text).
SMTP_ALLOW_PLAINTEXT=
POSTMARK_SERVER_TOKEN=
# user:pass in Postmark's inbound and bounce webhook URLs (§16); empty refuses every call.
POSTMARK_WEBHOOK_BASIC_AUTH=
MAIL_FROM=abuse-reports@example.test
REPLY_DOMAIN=reply.example.test
NOTICES_DRY_RUN=true
DRY_RUN_REDIRECT_EMAIL=operator@example.test
OPS_ALERT_EMAIL=operator@example.test

# --- External services (empty = feature skipped) ----------------------------------------------
WEBRISK_API_KEY=
CZDS_USERNAME=
CZDS_PASSWORD=
# Empty: every approved TLD except com and net; * every approved TLD (prod); or a list such as
# xyz,top,online,com
CZDS_TLDS=
CERTSTREAM_URL=
SENTRY_DSN=

# Test only: CIDRs the SSRF-protected client may reach (fixture network). Empty in prod.
SSRF_ALLOW_CIDRS=

# --- Production only: never set these locally -------------------------------------------------
# Listed for completeness (architecture.md §26); nothing local reads them.
# Secret Manager grafana-admin-password; the VM's Grafana container gets it as
# GF_SECURITY_ADMIN_PASSWORD (infra/terraform/README.md, step 4).
# GRAFANA_ADMIN_PASSWORD=
# Secret Manager redis-app-password and redis-browser-password (Terraform generates them); the
# VM's secret loader hashes them into the Redis ACL file and no container gets them:
# REDIS_APP_PASSWORD=
# REDIS_BROWSER_PASSWORD=
# Compose settings on the VM, written by the deploy into /opt/kalkan/.env. COMPOSE_PROFILES comes
# from the repository variable of the same name: comma-separated browser, ai, ops; empty = none.
# REGISTRY=europe-central2-docker.pkg.dev/my-gcp-project/kalkan
# IMAGE_TAG=<full git SHA>
# CLOUDSQL_INSTANCE=my-gcp-project:europe-central2:kalkan-db
# GCP_PROJECT_ID=my-gcp-project
# COMPOSE_PROFILES=browser
