    "e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.1",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.17.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.8.0",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
