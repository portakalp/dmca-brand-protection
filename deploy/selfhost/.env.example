# Kalkan self-hosted settings: ./init-env.sh copies this file to .env (chmod 600) and replaces
# every change-me value with a random secret. Then set the addresses and the SMTP server below.
# Never commit .env.

# --- Addresses -------------------------------------------------------------------------------
# Both names must point at this server (A/AAAA records); Caddy gets their certificates.
APP_DOMAIN=app.example.com
EVIDENCE_DOMAIN=evidence.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=admin@example.com

# Optional parts, comma-separated: browser, ai, ct, monitoring (docker-compose.yml).
COMPOSE_PROFILES=

# --- Secrets (init-env.sh generates them) ----------------------------------------------------
# Hex only: they go into connection URLs without escaping.
POSTGRES_PASSWORD=change-me
DB_OWNER_PASSWORD=change-me
DB_API_PASSWORD=change-me
DB_WORKER_PASSWORD=change-me
REDIS_PASSWORD=change-me
REDIS_BROWSER_PASSWORD=change-me
# Caddy sends it to the api with every request; the api refuses requests without it.
EDGE_SHARED_SECRET=change-me
# Fernet key for the TOTP secrets (32 random bytes, URL-safe base64). Losing it means every
# user and operator has to set up TOTP again.
TOTP_ENCRYPTION_KEY=change-me
# Grafana's admin password (profile monitoring).
GRAFANA_ADMIN_PASSWORD=change-me

# --- E-mail ----------------------------------------------------------------------------------
# Notices, invitations and password resets go through your SMTP server:
#   smtp+starttls://user:password@smtp.example.com:587   or   smtps://user:password@host:465
# User and password percent-encoded; credentials over plain smtp:// are refused. Plain smtp://
# is accepted only for a relay on this server or its private network (loopback, a private
# address or a compose service name) unless SMTP_ALLOW_PLAINTEXT=true.
# EMAIL_PROVIDER=postmark with POSTMARK_SERVER_TOKEN uses Postmark's API instead; replies and
# bounces are tracked only through Postmark's webhooks (POSTMARK_WEBHOOK_BASIC_AUTH).
EMAIL_PROVIDER=smtp
SMTP_URL=smtp+starttls://user:password@smtp.example.com:587
SMTP_ALLOW_PLAINTEXT=false
MAIL_FROM=abuse-reports@example.com
REPLY_DOMAIN=reply.example.com
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_BASIC_AUTH=
# Abuse notices are only simulated until this is false: each one goes to DRY_RUN_REDIRECT_EMAIL.
NOTICES_DRY_RUN=true
DRY_RUN_REDIRECT_EMAIL=you@example.com

# --- Application -----------------------------------------------------------------------------
CASE_PREFIX=KLK
LOG_LEVEL=INFO
# 127.0.0.1 port of the ops panel (SSH tunnel).
OPS_PORT=8081

# --- AI (profile ai; costs money) ------------------------------------------------------------
# Empty AI_ENABLED: on when ANTHROPIC_API_KEY is set. Set the key together with the ai profile;
# without it cases that would go to the AI go to the review queue (reason ai_disabled).
ANTHROPIC_API_KEY=
AI_ENABLED=
AI_TRIAGE_MODEL=claude-haiku-5-5
AI_CONFIRM_MODEL=claude-sonnet-5-5
AI_TEXT_MODEL=claude-sonnet-5-5
AI_REPLY_MODEL=claude-haiku-5-5
AI_MONTHLY_BUDGET_USD=50
ALERT_AI_DAILY_USD=5
AI_PRICES=

# --- Browser (profile browser) ---------------------------------------------------------------
# Daily cap of page traffic through egress-proxy (GB); captures wait once it is reached.
PROXY_DAILY_GB_LIMIT=20

# --- Optional sources (empty = skipped) ------------------------------------------------------
WEBRISK_API_KEY=
CZDS_USERNAME=
CZDS_PASSWORD=
CZDS_TLDS=
SENTRY_DSN=

# --- Monitoring (profile monitoring) ---------------------------------------------------------
# Alarms by SMTP: host:port of your server, its login, the sender and the recipient.
ALERT_SMTP_SMARTHOST=smtp.example.com:587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=true
ALERT_MAIL_FROM=alerts@example.com
OPS_ALERT_EMAIL=
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
