# Secret Manager containers for the §26 secrets (K78). The id is the env var name lowercased
# with "_" -> "-". Terraform writes the database and VM Redis passwords and URLs;
# EDGE_SHARED_SECRET, TOTP_ENCRYPTION_KEY and GRAFANA_ADMIN_PASSWORD are generated by the operator
# (README.md); the provider keys and ALERT_SMTP_PASSWORD (Alertmanager's SMTP account) come from
# the providers. A container without a version is skipped by the VM's secret loader, and the
# deploy binds an optional one to Cloud Run only once it has an enabled version.

locals {
  # Secret id => service accounts (iam.tf) that read it.
  secret_readers = {
    "database-url-api"            = ["api"]
    "database-url-worker"         = ["vm"]
    "database-url-migrate"        = ["vm"]
    "db-owner-password"           = ["vm"]
    "db-api-password"             = ["vm"]
    "db-worker-password"          = ["vm"]
    "redis-app-password"          = ["vm"]
    "redis-browser-password"      = ["vm"]
    "redis-url"                   = ["vm"]
    "redis-browser-url"           = ["vm"]
    "edge-shared-secret"          = ["api", "web"]
    "totp-encryption-key"         = ["api", "vm"]
    "anthropic-api-key"           = ["vm"]
    "proxy-map"                   = ["vm"]
    "postmark-server-token"       = ["api", "vm"]
    "postmark-webhook-basic-auth" = ["api"]
    "webrisk-api-key"             = ["vm"]
    "czds-username"               = ["vm"]
    "czds-password"               = ["vm"]
    "sentry-dsn"                  = ["api", "vm"]
    "grafana-admin-password"      = ["vm"]
    "alert-smtp-password"         = ["vm"]
  }

  secret_access = merge([
    for id, readers in local.secret_readers : {
      for sa in readers : "${id}/${sa}" => { secret = id, sa = sa }
    }
  ]...)

  # The deploy (kalkan-ci) checks which of these have an enabled version before binding them to
  # Cloud Run, so it may list their versions; it cannot read the values.
  run_secrets = toset([
    for id, readers in local.secret_readers : id if contains(readers, "api") || contains(readers, "web")
  ])

  # Values Terraform generates. Ephemeral: they never reach the plan or the state.
  db_connection = google_sql_database_instance.main.connection_name
  generated_secret_data = {
    "db-owner-password"      = ephemeral.random_password.db["owner"].result
    "db-api-password"        = ephemeral.random_password.db["api"].result
    "db-worker-password"     = ephemeral.random_password.db["worker"].result
    "database-url-api"       = "postgresql+psycopg://kalkan_api:${ephemeral.random_password.db["api"].result}@/${local.db_name}?host=/cloudsql/${local.db_connection}"
    "database-url-worker"    = "postgresql+psycopg://kalkan_worker:${ephemeral.random_password.db["worker"].result}@cloud-sql-proxy:5432/${local.db_name}"
    "database-url-migrate"   = "postgresql+psycopg://kalkan_owner:${ephemeral.random_password.db["owner"].result}@cloud-sql-proxy:5432/${local.db_name}"
    "redis-app-password"     = ephemeral.random_password.redis["app"].result
    "redis-browser-password" = ephemeral.random_password.redis["browser"].result
    "redis-url"              = "redis://kalkan:${ephemeral.random_password.redis["app"].result}@redis:6379/0"
    "redis-browser-url"      = "redis://browser:${ephemeral.random_password.redis["browser"].result}@redis:6379/0"
  }
  # Secret id => the variable that rotates it. Keys listed separately: for_each cannot use a value
  # derived from ephemeral data.
  generated_secret_versions = {
    "db-owner-password"      = var.db_password_version
    "db-api-password"        = var.db_password_version
    "db-worker-password"     = var.db_password_version
    "database-url-api"       = var.db_password_version
    "database-url-worker"    = var.db_password_version
    "database-url-migrate"   = var.db_password_version
    "redis-app-password"     = var.redis_password_version
    "redis-browser-password" = var.redis_password_version
    "redis-url"              = var.redis_password_version
    "redis-browser-url"      = var.redis_password_version
  }
}

# Passwords of the VM Redis ACL users: `kalkan` for the app containers, `browser` for
# worker-browser (K82). The VM's secret loader hashes them into the ACL file.
ephemeral "random_password" "redis" {
  for_each = toset(["app", "browser"])

  length  = 40
  special = false
}

resource "google_secret_manager_secret" "kalkan" {
  for_each = local.secret_readers

  secret_id           = each.key
  deletion_protection = true

  replication {
    auto {}
  }
}

# Each group (database, Redis) is written in the same apply, so the passwords inside the URLs match
# the password secrets and kalkan_owner. Rotation: bump var.db_password_version or
# var.redis_password_version, apply, deploy (README.md).
resource "google_secret_manager_secret_version" "generated" {
  for_each = local.generated_secret_versions

  secret                 = google_secret_manager_secret.kalkan[each.key].id
  secret_data_wo         = local.generated_secret_data[each.key]
  secret_data_wo_version = tostring(each.value)
  # A rotation disables the previous version instead of destroying it.
  deletion_policy = "DISABLE"
}

resource "google_secret_manager_secret_iam_member" "accessor" {
  for_each = local.secret_access

  secret_id = google_secret_manager_secret.kalkan[each.value.secret].id
  role      = "roles/secretmanager.secretAccessor"
  member    = google_service_account.kalkan[each.value.sa].member
}

resource "google_secret_manager_secret_iam_member" "ci_viewer" {
  for_each = local.run_secrets

  secret_id = google_secret_manager_secret.kalkan[each.key].id
  role      = "roles/secretmanager.viewer"
  member    = google_service_account.kalkan["ci"].member
}
