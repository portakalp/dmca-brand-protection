# Non-secret prod settings shared by the application containers on the VM (architecture.md §26).
# The deploy appends this deployment's values (GCS buckets, APP_BASE_URL, EVIDENCE_BASE_URL,
# MAIL_FROM, REPLY_DOMAIN, DRY_RUN_REDIRECT_EMAIL, OPS_ALERT_EMAIL, CASE_PREFIX and the alert mail
# relay ALERT_SMTP_SMARTHOST / ALERT_SMTP_USERNAME) and writes the result to /opt/kalkan/app.env.
# Secrets come from Secret Manager (vm/secrets.map), REDIS_URL included: it carries a Redis
# password.
# Test-only settings (SSRF allow list, storage emulator) must never appear here; the deploy and
# deploy.sh refuse them. worker-browser does not read this file.
ENV=prod
LOG_LEVEL=INFO
# Abuse notices go out through Postmark here (postmark-server-token); smtp (SMTP_URL) works too.
EMAIL_PROVIDER=postmark
CERTSTREAM_URL=ws://certstream:8080/
# Every TLD approved in the CZDS account, com and net included.
CZDS_TLDS=*
# Real notices stay off until you switch them on deliberately (go-live).
NOTICES_DRY_RUN=true
# worker-default and the scheduler hand triage, confirmation, notice text and reply
# classification to worker-ai. They never get the Anthropic key (only worker-ai does), so the key
# cannot switch this on for them; set false when the ai profile is off, and those cases go to
# human review instead of piling up in the ai queue.
AI_ENABLED=true
# The monthly AI budget (K125) and the alarm line of a day's spend (§23); the scheduler exports
# both to Prometheus.
AI_MONTHLY_BUDGET_USD=50
ALERT_AI_DAILY_USD=5
