{
  "uid": "kalkan-pipeline",
  "title": "Kalkan \u00b7 Pipeline",
  "description": "Discovery, capture and case flow (architecture.md \u00a723).",
  "tags": [
    "kalkan"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
